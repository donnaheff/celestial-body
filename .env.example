# ── Database ────────────────────────────────────────────────────────────
# Local dev: `docker compose up -d`, then this matches docker-compose.yml.
DATABASE_URL=postgres://acme_bids:acme_bids@localhost:5432/acme_bids

# ── Auth (NextAuth / Auth.js) ──────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Allowlist of emails auto-promoted to the "admin" role on sign-in/registration.
# Comma-separated, no spaces required.
ADMIN_EMAILS=you@acmebids.co.uk

# OAuth — each provider is optional; the sign-in page only shows buttons for
# providers with both ID and secret set. Leave unset to run with email/
# password only during early development.
#
# Google: https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: {APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Apple: https://developer.apple.com/account/resources/identifiers/list/serviceId
#   AUTH_APPLE_SECRET must be a signed JWT client secret you generate yourself
#   (Apple doesn't issue a static secret) — see next-auth's Apple provider docs.
#   Redirect URI: {APP_URL}/api/auth/callback/apple
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# Facebook: https://developers.facebook.com/apps
#   Redirect URI: {APP_URL}/api/auth/callback/facebook
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# X (Twitter), OAuth 2.0: https://developer.x.com/en/portal/dashboard
#   Redirect URI: {APP_URL}/api/auth/callback/twitter
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=

# ── App URL ─────────────────────────────────────────────────────────────
# Used for OAuth/webhook redirect URLs. Set to your real origin in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Flutterwave (card & bank escrow) ───────────────────────────────────
# https://dashboard.flutterwave.com/settings/apis — use TEST keys until go-live.
FLW_SECRET_KEY=
# https://dashboard.flutterwave.com/settings/webhooks — set this exact string
# as the "Secret Hash" there too; it's echoed back in the verif-hash header.
FLW_WEBHOOK_SECRET_HASH=

# ── Smart-contract escrow (Sepolia testnet) ────────────────────────────
# Deploy contracts/ first (see contracts/README.md), then fill these in.
NEXT_PUBLIC_ESCROW_CONTRACT_ADDRESS=
# Acme Bids' payout wallet — receives released milestones.
NEXT_PUBLIC_ESCROW_PROVIDER_ADDRESS=
# Optional: a dedicated RPC URL for server-side verification calls (falls
# back to viem's public Sepolia endpoint if unset — fine for light use).
ESCROW_RPC_URL=
# Testnet-only indicative GBP->ETH conversion for the demo checkout amount.
NEXT_PUBLIC_TEST_ETH_PER_GBP=0.0003

# ── One-off admin seeding (db/seed.ts) ─────────────────────────────────
# Not read by the app itself — pass at seed time, e.g.:
#   ADMIN_SEED_EMAIL=you@acmebids.co.uk ADMIN_SEED_PASSWORD=changeme npm run db:seed
