# RPC endpoint for Sepolia (e.g. from Alchemy, Infura, or a public endpoint).
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key

# Private key of the deployer wallet, funded with Sepolia test ETH from a faucet.
# NEVER commit this or use a key that holds real funds.
DEPLOYER_PRIVATE_KEY=0xyourprivatekey

# Address that acts as dispute arbiter for deployed escrows (a multisig in production).
ARBITER_ADDRESS=0xyourarbiteraddress
